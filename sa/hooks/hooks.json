{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-protected.sh\"",
            "statusMessage": "sa: checking file is not a secret"
          }
        ]
      }
    ]
  }
}
